# Copy to .env.local and point at your running kaya-nest-api instance.
#
# .env.local must never be committed.

# ── Public ───────────────────────────────────────────────────
# Shipped in the browser bundle — this is a static export, so it's baked in
# at build time. Without it the dashboard runs in preview mode: real site
# content loaded into your browser's storage, nothing touches a backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# The kaya-nest-api instance you point at must include this dashboard's
# origin in its own CORS_ORIGINS env var, or the browser will refuse the
# login request.
